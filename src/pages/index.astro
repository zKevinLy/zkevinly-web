---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
---

<Layout>
  <section class="hero">
    <p class="hero-eyebrow" data-reveal>
      {site.domain}
    </p>

    <h1 class="hero-title" data-reveal>
      {site.tagline}
    </h1>

    <p class="hero-lead" data-reveal>
      {site.home.description}
    </p>
  </section>
</Layout>
