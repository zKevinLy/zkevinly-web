---
import Layout from '../layouts/Layout.astro';
import { site, type DirectoryPage, type TopicPage } from '../config';

const sections = Object.entries(site.pages).filter(([, page]) => page.type === 'directory') as [
  string,
  DirectoryPage,
][];

const topics = Object.entries(site.pages).filter(([, page]) => page.type === 'topic') as [
  string,
  TopicPage,
][];
---

<Layout>
  <section class="hero">
    <p class="hero-eyebrow" data-reveal>
      {site.domain}
    </p>

    <h1 class="hero-title" data-reveal>
      {site.tagline}
    </h1>

    <p class="hero-lead" data-reveal>
      {site.home.description}
    </p>
  </section>
</Layout>
