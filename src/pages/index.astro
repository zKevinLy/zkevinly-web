---
import Layout from '../layouts/Layout.astro';
import { site, type DirectoryPage, type TopicPage } from '../config';

const sections = Object.entries(site.pages).filter(
  ([, page]) => page.type === 'directory'
) as [string, DirectoryPage][];

const topics = Object.entries(site.pages).filter(
  ([, page]) => page.type === 'topic'
) as [string, TopicPage][];
---

<Layout>
  <section class="hero">
    <p class="hero-eyebrow" data-reveal>
      {site.domain}
    </p>

    <h1 class="hero-title" data-reveal>
      {site.tagline}
    </h1>

    <p class="hero-lead" data-reveal>
      {site.home.description}
    </p>
  </section>

  <!-- Directories -->
  <section class="home-section">
    <h2 class="section-title" data-reveal>
      Directories
    </h2>

    <div class="grid grid-3">
      {sections.map(([slug, section]) => (
        <a
          href={`/${slug}`}
          data-reveal
          class="card"
        >
          <div class="card-head">
            <h3 class="card-title">
              {section.title}
            </h3>

            <span class="card-meta">
              {String(section.items.length).padStart(2, '0')}
            </span>
          </div>

          <p class="card-desc">
            {section.description}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Topics -->
  {topics.length > 0 && (
    <section class="home-section">
      <h2 class="section-title" data-reveal>
        Topics
      </h2>

      <p class="section-note" data-reveal>
        Guides, collections, and useful information.
      </p>

      <div class="grid grid-3">
        {topics.map(([slug, topic]) => (
          <a
            href={`/${slug}`}
            data-reveal
            class="card"
          >
            <h3 class="card-title">
              {topic.title}
            </h3>

            <p class="card-desc">
              {topic.description}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>