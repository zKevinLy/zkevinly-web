---
import { siGithub } from 'simple-icons';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/base/PageHeader.astro';
import Prose from '../components/base/Prose.astro';
import Button from '../components/base/Button.astro';
import { site } from '../config';

const { about } = site;
---

<Layout title={about.title} description={about.description}>
  <PageHeader title={about.title} lead={about.intro} />

  <div class="about-body">
    {about.paragraphs.map((text) => (
      <Prose reveal>{text}</Prose>
    ))}
  </div>

  <div class="about-links" data-reveal>
    <Button href={site.github} external>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d={siGithub.path}></path>
      </svg>
      GitHub
    </Button>
  </div>
</Layout>
