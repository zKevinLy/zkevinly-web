---
import Layout from './Layout.astro';
import Card from '../components/Card.astro';
import type { DirectoryPage } from '../config';

interface Props {
  page: DirectoryPage;
}

const { page } = Astro.props;
---

<Layout title={page.title} description={page.description}>
  <h1 class="page-title" data-reveal>{page.title}</h1>

  <p class="page-lead" data-reveal>{page.description}</p>

  <div class="grid">
    {page.items.map((entry) => <Card entry={entry} />)}
  </div>
</Layout>
