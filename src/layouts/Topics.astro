---
import Layout from './Layout.astro';
import PageHeader from '../components/base/PageHeader.astro';
import Section from '../components/base/Section.astro';
import Grid from '../components/base/Grid.astro';
import Breadcrumb from '../components/base/Breadcrumb.astro';
import TopicCard from '../components/composite/TopicCard.astro';
import TopicBlocks from '../components/composite/TopicBlocks.astro';
import type { TopicPage } from '../config';
import { getBreadcrumbs, normalizePath } from '../lib/navigation';

interface Props {
  page: TopicPage;
}

const { page } = Astro.props;

const breadcrumbs = getBreadcrumbs(Astro.url.pathname);
const currentPath = normalizePath(Astro.url.pathname);
---

<Layout title={page.title} description={page.description}>
  <Breadcrumb items={breadcrumbs} />

  <PageHeader title={page.title} lead={page.introduction ?? page.description} spaced />

  {page.children && page.children.length > 0 && (
    <Section title={`Explore ${page.title}`} class="topic-section">
      <Grid tight>
        {page.children.map((child) => (
          <TopicCard
            title={child.title}
            description={child.description}
            href={`${currentPath}/${child.slug}`}
          />
        ))}
      </Grid>
    </Section>
  )}

  <TopicBlocks blocks={page.blocks} />
</Layout>
