---
// Layout for /toolkit pages: the same shell as Layout.astro with two deliberate differences, so
// the "nothing leaves this page" promise holds:
//   - no ClientRouter (transitions off): every move between the toolkit and the rest of the site
//     is a full page load, so the strict Content-Security-Policy in public/_headers always applies;
//   - no ChatBot: it fetches GIFs from another origin, which that policy blocks.
import BaseLayout from '@zkevinly/ui/layouts/Layout.astro';
import { shellProps } from '../lib/ui/shell';
import '../styles/global.css';
import '../styles/toolkit/tool.css';

interface Props {
  title?: string;
  description?: string;
  /** Set false to keep a page out of the search index. */
  indexable?: boolean;
}

const shell = shellProps();
const { title, description = shell.description, indexable = true } = Astro.props;
---

<BaseLayout
  {...shell}
  title={title}
  description={description}
  indexable={indexable}
  transitions={false}
>
  <slot />
</BaseLayout>
