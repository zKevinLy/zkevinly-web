---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/composite/Header.astro';
import Search from '../components/composite/Search.astro';
import ChatBot from '../components/composite/ChatBot.astro';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <title>{fullTitle}</title>

    <link rel="stylesheet" href="/index.css" />

    <!-- Apply the saved theme before first paint (dark by default) so there's no flash. -->
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {
          // Storage blocked: fall back to the dark default.
        }
        document.documentElement.dataset.theme = theme;
      })();

      // Keep the theme across ClientRouter page swaps.
      document.addEventListener('astro:before-swap', (event) => {
        event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
      });
    </script>

    <ClientRouter />
  </head>
  <body>
    <Header />
    <main class="page" transition:animate="fade">
      <slot />
    </main>
    <!-- Must be a direct child of <body>, outside the header (see index.css). -->
    <Search />
    <ChatBot />

    <script>
      import { gsap } from 'gsap';

      // Runs on first load and after every View Transition navigation.
      document.addEventListener('astro:page-load', () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        gsap.from('[data-reveal]', {
          y: 16,
          opacity: 0,
          duration: 0.6,
          stagger: 0.06,
          ease: 'power2.out',
          clearProps: 'all',
        });
      });
    </script>
  </body>
</html>
