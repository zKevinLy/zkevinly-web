---
// This site's layout: the UI package's page shell plus the chat bot. Order matters: the package
// imports its styles first, then this site's own (global.css) override them.
import BaseLayout from '@zkevinly/ui/layouts/Layout.astro';
import ChatBot from '../components/ChatBot.astro';
import { shellProps } from '../lib/ui/shell';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Set false to keep a page (e.g. 404) out of the search index. */
  indexable?: boolean;
}

const shell = shellProps();
const { title, description = shell.description, indexable = true } = Astro.props;
---

<BaseLayout {...shell} title={title} description={description} indexable={indexable}>
  <slot />
  <ChatBot slot="end" />
</BaseLayout>
