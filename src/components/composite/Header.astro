---
import { CircleUserRound, Moon, Search, Sun } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import IconButton from '../base/IconButton.astro';
import NavLink from '../base/NavLink.astro';
import { site } from '../../config';
import { getNavItems, isActivePath } from '../../lib/navigation';

const nav = getNavItems();
const pathname = Astro.url.pathname;
const isActive = (href: string) => isActivePath(pathname, href);

// Set at build time by CI (PUBLIC_APP_VERSION); local dev shows "dev".
const version =
  (import.meta.env.PUBLIC_APP_VERSION as string | undefined) ||
  (import.meta.env.DEV ? 'dev' : undefined);
---

<header class="topbar" transition:persist>
  <div class="topbar-inner">
    <div class="brand-group">
      <a href="/" class="brand">
        {site.name.toLowerCase()}
        <span>/</span>
      </a>
      {version && (
        <span class="brand-version" title="Site version">
          {version}
        </span>
      )}
    </div>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <NavLink href={item.href} current={isActive(item.href)}>
          {item.label}
        </NavLink>
      ))}
    </nav>

    <div class="topbar-actions">
      <button id="search-open" type="button" class="search-trigger" aria-label="Open site search">
        <Search size={16} aria-hidden="true" />
        <span class="search-trigger-label">Search anything...</span>
        <kbd>Ctrl K</kbd>
      </button>

      <IconButton id="theme-toggle" label="Switch to light mode" tooltip="Light mode">
        <Sun class="theme-icon-sun" size={19} aria-hidden="true" />
        <Moon class="theme-icon-moon" size={19} aria-hidden="true" />
      </IconButton>

      <IconButton href="/about" navHref="/about" label="About me" current={isActive('/about')}>
        <CircleUserRound size={19} aria-hidden="true" />
      </IconButton>

      <IconButton href={site.github} label="GitHub" external>
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
          <path d={siGithub.path}></path>
        </svg>
      </IconButton>
    </div>
  </div>

  <!-- Mobile navigation -->
  <nav class="nav-mobile" aria-label="Primary (mobile)">
    {nav.map((item) => (
      <NavLink href={item.href} current={isActive(item.href)}>
        {item.label}
      </NavLink>
    ))}
  </nav>
</header>

<script>
  import { isActivePath } from '../../lib/navigation';

  // --- Active link highlighting (header persists across navigations) ---
  function updateActiveNavigation() {
    const path = window.location.pathname;

    document.querySelectorAll<HTMLElement>('[data-nav-href]').forEach((link) => {
      const active = isActivePath(path, link.dataset.navHref ?? '');

      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', updateActiveNavigation);
  updateActiveNavigation();

  // --- Theme toggle (dark by default, remembered in localStorage) ---
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

  function syncToggleLabel() {
    if (!toggle) return;
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    toggle.setAttribute('aria-label', `Switch to ${next} mode`);
    toggle.dataset.tooltip = next === 'light' ? 'Light mode' : 'Dark mode';
  }

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage unavailable (private mode); the choice just won't persist.
    }
    syncToggleLabel();
  });

  syncToggleLabel();
</script>
