---
/**
 * COMPOSITE: a directory entry. Node + Tags + CommandList + RelatedList + RepoMeta.
 * This is the "rich" card used on Projects / Resources.
 */
import Node from '../base/Node.astro';
import Tags from '../base/Tags.astro';
import CommandList from './CommandList.astro';
import RelatedList from './RelatedList.astro';
import RepoMeta from './RepoMeta.astro';
import type { Entry } from '../../config';
import { entryRepo, fetchRepoInfo } from '../../lib/github';
import { entrySource, filterAttrs } from '../../lib/filter';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;

const repo = entryRepo(entry);

// Fetched once here: RepoMeta renders it, and the filter bar sorts by it.
// Shell env vars (CI) are only guaranteed on process.env; .env files land on import.meta.env.
const token = process.env.GITHUB_TOKEN || import.meta.env.GITHUB_TOKEN;
const info = repo ? await fetchRepoInfo(repo, token) : null;
---

<Node
  title={entry.title}
  description={entry.description}
  href={entry.href}
  searchable
  {...filterAttrs(entrySource(entry), info)}
>
  <Tags tags={entry.tags} />
  <CommandList commands={entry.commands} />
  <RelatedList links={entry.related} />
  <RepoMeta
    slot="foot"
    repo={repo}
    info={info}
    updated={entry.updated}
    isPrivate={entry.repoPrivate}
  />
</Node>
