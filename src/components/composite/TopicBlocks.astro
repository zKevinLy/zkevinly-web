---
/** COMPOSITE: renders a topic page's content blocks using the base components. */
import Section from '../base/Section.astro';
import Prose from '../base/Prose.astro';
import Grid from '../base/Grid.astro';
import Steps from '../base/Steps.astro';
import Figure from '../base/Figure.astro';
import Node from '../base/Node.astro';
import Tags from '../base/Tags.astro';
import Workflow from './Workflow.astro';
import EntryCard from './EntryCard.astro';
import HubIndex from './HubIndex.astro';
import Installer from './Installer.astro';
import DownloadButton from './DownloadButton.astro';
import type { TopicBlock, TopicPage } from '../../config';
import { filterAttrs } from '../../lib/filter';
import { installableApps } from '../../lib/installer';

interface Props {
  blocks: TopicBlock[];
  /** Needed by `index` blocks, which render the page's own children. */
  page?: TopicPage;
  path?: string;
}

const { blocks, page, path } = Astro.props;

// Entry cards only get their checkbox when this page has an installer to feed.
const installApps = blocks.some((block) => block.type === 'installer')
  ? installableApps(blocks)
  : [];
---

<div class="topic-blocks">
  {blocks
    .filter((block) => !(block.type === 'text' && block.title?.toLowerCase().startsWith('about ')))
    .map((block) => (
      <Section
        title={block.title}
        note={
          block.type === 'links' ||
          block.type === 'entries' ||
          block.type === 'index' ||
          block.type === 'installer'
            ? block.description
            : undefined
        }
        filterGroup={block.type === 'links' || block.type === 'entries'}
        reveal={block.type !== 'entries'}
      >
        {block.type === 'text' && <Prose>{block.content}</Prose>}

        {block.type === 'links' && (
          <Grid tight>
            {block.items.map((link) => (
              <Node
                title={link.title}
                description={link.description}
                href={link.download ? undefined : link.href}
                label={link.label}
                size="compact"
                {...filterAttrs(link)}
              >
                <Tags tags={link.tags} />
                {link.download && <DownloadButton href={link.href} filename={link.download} />}
              </Node>
            ))}
          </Grid>
        )}

        {block.type === 'entries' && (
          <Grid>
            {block.items.map((entry) => (
              <EntryCard entry={entry} selectable={installApps.length > 0} />
            ))}
          </Grid>
        )}

        {block.type === 'installer' && <Installer apps={installApps} />}

        {block.type === 'steps' && <Steps items={block.items} />}

        {block.type === 'workflow' && (
          <>
            {block.description && <p class="workflow-intro">{block.description}</p>}
            <Workflow nodes={block.nodes} phases={block.phases} />
          </>
        )}

        {block.type === 'index' && page && path && <HubIndex page={page} path={path} />}

        {block.type === 'image' && (
          <Figure src={block.src} alt={block.alt} caption={block.caption} />
        )}
      </Section>
    ))}
</div>
