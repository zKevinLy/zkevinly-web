---
/** COMPOSITE: a curated external link inside a topic page. Card (compact) with an optional label. */
import Card from '../base/Card.astro';
import type { TopicLink } from '../../config';

interface Props {
  link: TopicLink;
}

const { link } = Astro.props;
---

<Card
  title={link.title}
  description={link.description}
  href={link.href}
  label={link.label}
  size="compact"
/>
