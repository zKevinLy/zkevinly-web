---
import { Check, Copy, ExternalLink, Star, Tag } from '@lucide/astro';
import type { Entry } from '../config';
import { fetchRepoInfo, freshness, parseRepo, relativeTime } from '../lib/github';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const external = /^https?:\/\//.test(entry.href);

// Repo is inferred from a github.com link unless explicitly set / disabled.
const repo = entry.repo === false ? null : (entry.repo ?? parseRepo(entry.href));

// Baked in at build time so the card is complete without JS. The browser then
// refreshes it (see <script> below). Set GITHUB_TOKEN at build time to avoid
// GitHub's 60 requests/hour unauthenticated limit.
const info = repo ? await fetchRepoInfo(repo, import.meta.env.GITHUB_TOKEN) : null;

const updated = info?.pushedAt ?? entry.updated;
const showFoot = Boolean(repo || updated);
---

<article
  class="card card-rich"
  data-reveal
  data-pagefind-body
  data-search-item
  data-repo={repo ?? undefined}
>
  {external && (
    <a
      class="card-external-link"
      href={entry.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Open ${entry.title} externally`}
      title="Open external link"
    >
      <ExternalLink size={16} aria-hidden="true" />
    </a>
  )}
  <div class="card-head">
    <h3 class="card-title">
      <a
        class="card-link"
        href={entry.href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
      >
        {entry.title}
      </a>
    </h3>
  </div>

  <p class="card-desc">{entry.description}</p>

  {entry.tags && entry.tags.length > 0 && (
    <div class="tags">
      {entry.tags.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  )}

  {entry.commands && entry.commands.length > 0 && (
    <div class="cmds">
      {entry.commands.map((c) => (
        <div class="cmd">
          {c.label && <span class="cmd-label">{c.label}</span>}
          <div class="cmd-row">
            <code class="cmd-text">{c.command}</code>
            <button
              type="button"
              class="cmd-copy"
              data-copy={c.command}
              aria-label={`Copy command: ${c.command}`}
            >
              <Copy class="cmd-icon-copy" size={14} aria-hidden="true" />
              <Check class="cmd-icon-done" size={14} aria-hidden="true" />
              <span class="cmd-copy-text">Copy</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  )}

  {showFoot && (
    <div class="card-foot">
      {repo && (
        <a
          class="badge badge-link"
          data-role="version"
          href={info?.releaseUrl ?? undefined}
          target="_blank"
          rel="noopener noreferrer"
          title="Latest release"
          hidden={!info?.version}
        >
          <Tag size={12} aria-hidden="true" />
          <span data-role="version-text">{info?.version}</span>
        </a>
      )}

      {repo && (
        <span class="badge" data-role="stars" title="GitHub stars" hidden={!info}>
          <Star size={12} aria-hidden="true" />
          <span data-role="stars-text">{info?.stars.toLocaleString('en-US')}</span>
        </span>
      )}

      <span
        class="updated"
        data-role="updated"
        data-fresh={updated ? freshness(updated) : undefined}
        hidden={!updated}
      >
        <span class="pulse" aria-hidden="true"></span>
        Updated
        <time
          datetime={updated}
          data-relative
          title={updated ? new Date(updated).toUTCString() : undefined}
        >
          {updated ? relativeTime(updated) : ''}
        </time>
      </span>
    </div>
  )}
</article>

<script>
  import { fetchRepoInfo, freshness, relativeTime, type RepoInfo } from '../lib/github';

  // ---------- Copy to clipboard (delegated: survives page swaps) ----------
  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Fallback for non-secure contexts / older browsers.
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
  }

  const resetTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy]');
    if (!button) return;

    await copyText(button.dataset.copy ?? '');

    const label = button.querySelector('.cmd-copy-text');
    button.classList.add('is-copied');
    if (label) label.textContent = 'Copied!';

    clearTimeout(resetTimers.get(button));
    resetTimers.set(
      button,
      setTimeout(() => {
        button.classList.remove('is-copied');
        if (label) label.textContent = 'Copy';
      }, 1800),
    );
  });

  // ---------- Relative timestamps ----------
  function refreshTimes() {
    document.querySelectorAll<HTMLTimeElement>('time[data-relative]').forEach((el) => {
      const iso = el.getAttribute('datetime');
      if (!iso) return;
      el.textContent = relativeTime(iso);
      el.closest<HTMLElement>('[data-fresh]')?.setAttribute('data-fresh', freshness(iso));
    });
  }

  // ---------- Live GitHub data (cached 1h in localStorage) ----------
  const TTL = 60 * 60 * 1000;

  async function getInfo(repo: string): Promise<RepoInfo | null> {
    const key = `gh:${repo}`;

    try {
      const raw = localStorage.getItem(key);
      if (raw) {
        const cached = JSON.parse(raw) as { t: number; info: RepoInfo };
        if (Date.now() - cached.t < TTL) return cached.info;
      }
    } catch {
      // Ignore unreadable cache.
    }

    const info = await fetchRepoInfo(repo);

    if (info) {
      try {
        localStorage.setItem(key, JSON.stringify({ t: Date.now(), info }));
      } catch {
        // Storage full/unavailable — fine, just refetch next time.
      }
    }

    return info; // null (rate-limited/offline) => keep the build-time values.
  }

  function applyInfo(card: HTMLElement, info: RepoInfo) {
    const version = card.querySelector<HTMLAnchorElement>('[data-role="version"]');
    const versionText = card.querySelector('[data-role="version-text"]');
    if (version && versionText) {
      version.hidden = !info.version;
      if (info.version) {
        versionText.textContent = info.version;
        if (info.releaseUrl) version.href = info.releaseUrl;
      }
    }

    const stars = card.querySelector<HTMLElement>('[data-role="stars"]');
    const starsText = card.querySelector('[data-role="stars-text"]');
    if (stars && starsText) {
      stars.hidden = false;
      starsText.textContent = info.stars.toLocaleString('en-US');
    }

    const updated = card.querySelector<HTMLElement>('[data-role="updated"]');
    const time = updated?.querySelector('time');
    if (updated && time && info.pushedAt) {
      updated.hidden = false;
      time.setAttribute('datetime', info.pushedAt);
      time.title = new Date(info.pushedAt).toUTCString();
      time.textContent = relativeTime(info.pushedAt);
      updated.dataset.fresh = freshness(info.pushedAt);
    }
  }

  async function refreshCards() {
    refreshTimes();

    const cards = document.querySelectorAll<HTMLElement>('[data-repo]');
    await Promise.all(
      Array.from(cards).map(async (card) => {
        const info = await getInfo(card.dataset.repo!);
        if (info) applyInfo(card, info);
      }),
    );
  }

  document.addEventListener('astro:page-load', refreshCards);

  // Keep "3 minutes ago" honest while the tab stays open.
  setInterval(refreshTimes, 60_000);
</script>
