---
import type { Entry } from '../config';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const external = /^https?:\/\//.test(entry.href);

const statusColor: Record<string, string> = {
  live: 'text-accent',
  wip: 'text-amber-300',
  archived: 'text-muted',
};
---

<a
  href={entry.href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-reveal
  data-pagefind-body
  data-search-item
  class="group block rounded-xl border border-border bg-surface p-5 transition-colors hover:border-accent/60"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-medium text-white group-hover:text-accent">{entry.title}</h3>
    {entry.status && (
      <span class:list={['font-mono text-[11px] uppercase', statusColor[entry.status]]}>
        {entry.status}
      </span>
    )}
  </div>
  <p class="mt-2 text-sm text-muted">{entry.description}</p>
  {entry.tags && entry.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {entry.tags.map((t) => (
        <span class="rounded-full border border-border px-2 py-0.5 font-mono text-[11px] text-muted">
          {t}
        </span>
      ))}
    </div>
  )}
</a>
