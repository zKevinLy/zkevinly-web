---
/**
 * BASE: Card — the single card primitive for the whole site.
 *
 * Every card (directory entries, topic children, link items…) is this component
 * with different content in its slots. Never hand-write `<div class="card">`
 * elsewhere; compose this instead.
 *
 * When `href` is set the title becomes a link whose ::after stretches over the
 * whole card, so the card is clickable while anything in the slots that needs
 * its own interaction (badges, copy buttons) sits above it (z-index: 2 in CSS).
 *
 * Slots
 *   default  body content, below the description
 *   foot     pinned to the bottom of the card
 */
import type { HTMLAttributes } from 'astro/types';
import { ExternalLink } from '@lucide/astro';

interface Props extends Omit<HTMLAttributes<'article'>, 'title'> {
  title: string;
  description?: string;
  /** Makes the card clickable. */
  href?: string;
  /** Small mono label shown at the top right (e.g. "Official"). */
  label?: string;
  size?: 'default' | 'compact';
  /** Fade/slide in on page load (see Layout's GSAP script). */
  reveal?: boolean;
  /** Include this card as its own search result. */
  searchable?: boolean;
}

const {
  title,
  description,
  href,
  label,
  size = 'default',
  reveal = false,
  searchable = false,
  class: className,
  ...attrs
} = Astro.props;

const external = href ? /^https?:\/\//.test(href) : false;
---

<article
  class:list={['card', size === 'compact' && 'card-compact', href && 'card-interactive', className]}
  data-reveal={reveal ? '' : undefined}
  data-pagefind-body={searchable ? '' : undefined}
  data-search-item={searchable ? '' : undefined}
  {...attrs}
>
  <div class="card-head">
    <h3 class="card-title">
      {href ? (
        <a
          class="card-link"
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          aria-label={external ? `${title} (opens in a new tab)` : undefined}
        >
          {title}
        </a>
      ) : (
        title
      )}
    </h3>

    {(label || external) && (
      <span class="card-aside">
        {label && <span class="card-label">{label}</span>}
        {external && <ExternalLink size={16} aria-hidden="true" />}
      </span>
    )}
  </div>

  {description && <p class="card-desc">{description}</p>}

  <slot />
  <slot name="foot" />
</article>
