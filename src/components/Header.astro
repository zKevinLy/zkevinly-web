---
import { CircleUserRound, Moon, Search, Sun } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import { site } from '../config';

const nav = Object.entries(site.pages)
  .filter(([, page]) => page.showInNav === true)
  .map(([slug, page]) => ({
    href: `/${slug}`,
    label: page.title,
  }));

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="topbar" transition:persist>
  <div class="topbar-inner">
    <a href="/" class="brand">
      {site.name.toLowerCase()}
      <span>/</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          data-nav-href={item.href}
          class="nav-link"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="topbar-actions">
      <button id="search-open" type="button" class="search-trigger" aria-label="Open site search">
        <Search size={16} aria-hidden="true" />
        <span class="search-trigger-label">Search anything...</span>
        <kbd>Ctrl K</kbd>
      </button>

      <button
        id="theme-toggle"
        type="button"
        class="icon-btn"
        aria-label="Switch to light mode"
        data-tooltip="Light mode"
      >
        <Sun class="theme-icon-sun" size={19} aria-hidden="true" />
        <Moon class="theme-icon-moon" size={19} aria-hidden="true" />
      </button>

      <a
        href="/about"
        class="icon-btn"
        data-nav-href="/about"
        data-tooltip="About me"
        aria-label="About me"
        aria-current={isActive('/about') ? 'page' : undefined}
      >
        <CircleUserRound size={19} aria-hidden="true" />
      </a>

      <a
        href={site.github}
        class="icon-btn"
        data-tooltip="GitHub"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
          <path d={siGithub.path}></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Mobile navigation -->
  <nav class="nav-mobile" aria-label="Primary (mobile)">
    {nav.map((item) => (
      <a
        href={item.href}
        data-nav-href={item.href}
        class="nav-link"
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  // --- Active link highlighting (header persists across navigations) ---
  function updateActiveNavigation() {
    const path = window.location.pathname.replace(/\/$/, '') || '/';

    document.querySelectorAll<HTMLElement>('[data-nav-href]').forEach((link) => {
      const href = link.dataset.navHref ?? '';
      const active = path === href || path.startsWith(href + '/');

      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', updateActiveNavigation);
  updateActiveNavigation();

  // --- Theme toggle (dark by default, remembered in localStorage) ---
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

  function syncToggleLabel() {
    if (!toggle) return;
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    toggle.setAttribute('aria-label', `Switch to ${next} mode`);
    toggle.dataset.tooltip = next === 'light' ? 'Light mode' : 'Dark mode';
  }

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage unavailable (private mode); the choice just won't persist.
    }
    syncToggleLabel();
  });

  syncToggleLabel();
</script>
