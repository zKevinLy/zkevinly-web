/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# The toolkit's tools handle sensitive data (invoices, records), so its pages get a much stricter
# policy: no requests to any other origin, and nothing but this site's own scripts. The
# `!` lines drop the site-wide values above so these replace them instead of stacking.
# 'wasm-unsafe-eval' is only for site search (Pagefind runs as WebAssembly).
/toolkit
  ! Referrer-Policy
  ! Content-Security-Policy
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' blob:; object-src blob:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
/toolkit/*
  ! Referrer-Policy
  ! Content-Security-Policy
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' blob:; object-src blob:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
