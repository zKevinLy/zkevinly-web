{
  "name": "zkevinly-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "astro check && astro build && pagefind --site dist",
    "build:fast": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "start": "astro preview --host 0.0.0.0 --port 4321",
    "prod": "npm ci && npm run build && npm run start",
    "clean": "rm -rf dist .astro",
    "rebuild": "npm run clean && npm run build",
    "outdated": "npm outdated",
    "update": "npm update",
    "update:latest": "npx npm-check-updates -u && npm install",
    "update:astro": "npx @astrojs/upgrade",
    "audit": "npm audit --omit=dev",
    "pin-actions": "node scripts/pin-actions.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^8.1.2",
    "@lucide/astro": "^1.70.0",
    "astro": "^7.4.4",
    "gsap": "^3.12.5",
    "simple-icons": "^16.36.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
