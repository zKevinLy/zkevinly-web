{
  "name": "zkevinly-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "check": "astro check",
    "build": "astro check && astro build && pagefind --site dist",
    "build:fast": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "start": "astro preview --host 0.0.0.0 --port 4321",
    "prod": "npm ci && npm run build && npm run start",
    "clean": "rm -rf dist .astro",
    "rebuild": "npm run clean && npm run build",
    "outdated": "npm outdated",
    "update": "npm update",
    "update:latest": "npx npm-check-updates -u && npm install",
    "update:astro": "npx @astrojs/upgrade",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^8.1.2",
    "@tailwindcss/typography": "^0.5.4",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.4.4",
    "gsap": "^3.12.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "vite": "^8.3.5"
  },
  "overrides": {}
}
