# Copy to .env (git-ignored) for local development only.

# Used by `npm run dev` so the chat bot can fetch GIFs from KLIPY locally.
# Production uses a Worker secret instead: `npx wrangler secret put KLIPY_API_KEY`.
KLIPY_API_KEY=

# Increases GITHUB API rate limits for the card badges at build time (optional).
GITHUB_TOKEN=
