# Copy to .env (git-ignored) for local development only.

# Used by `npm run dev` so the chat bot can fetch GIFs from GIPHY locally.
# Get a free key at https://developers.giphy.com (choose "API", not "SDK").
# Production uses a Worker secret instead: `npx wrangler secret put GIPHY_API_KEYS`.
# Put one key, or several separated by commas; each request uses a random one.
GIPHY_API_KEYS=

# Optional: GIF content rating (g, pg, pg-13 or r). Defaults to pg.
# GIPHY_RATING=pg

# Increases GITHUB API rate limits for the card badges at build time (optional).
# To show release/commit info for PRIVATE repos (AIOPlugins, Perkday), use a fine-grained
# personal access token with read-only "Contents" + "Metadata" on those repos; the default
# Actions GITHUB_TOKEN can only read this repo. Cards just hide the badges if it can't.
GITHUB_TOKEN=
