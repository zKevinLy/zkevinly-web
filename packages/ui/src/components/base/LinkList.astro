---
/**
 * BASE: a stack of link rows styled to match CommandBlock: related pages, external links
 * and file downloads. Renders nothing when empty.
 *
 * A row with `download` saves that file name (same-origin files only: browsers ignore
 * `download` on other sites). External rows open in a new tab.
 */
import { ArrowRight, Download, ExternalLink } from '@lucide/astro';
import type { LinkItem } from '../../types';

interface Props {
  links?: LinkItem[];
}

const { links = [] } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

{links.length > 0 && (
  <div class="cmds related">
    {links.map((link) => {
      const external = !link.download && isExternal(link.href);
      const action = link.action ?? (link.download ? 'Download' : external ? 'Open' : 'View');
      return (
        <div class="cmd">
          {link.label && <span class="cmd-label">{link.label}</span>}
          <a
            class="cmd-row related-link"
            href={link.href}
            download={link.download}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <span class="cmd-text related-text">{link.title}</span>
            <span class="copy-btn related-go" aria-hidden="true">
              {link.download ? (
                <Download size={14} />
              ) : external ? (
                <ExternalLink size={14} />
              ) : (
                <ArrowRight size={14} />
              )}
              <span class="copy-btn-text">{action}</span>
            </span>
          </a>
        </div>
      );
    })}
  </div>
)}
