---
/**
 * BASE: Node — the single card / step primitive for the whole site.
 *
 * Every card (directory entries, topic children, link items, workflow steps…)
 * is this component with different props and slot content. Never hand-write a
 * `<div class="node">` elsewhere, and never add a second card-like component:
 * extend this one's props instead.
 *
 * Layout
 *   head    [icon] [number] title ..... [ping] [badges] [label] [link icon] [checkbox]
 *   body    description, default slot, secondary `links`
 *   foot    pinned to the bottom (foot slot)
 *
 * `href` makes the whole node clickable (the title link stretches over it); the
 * icon in the top-right cluster says where it goes: ExternalLink for other
 * sites, ChevronRight for pages on this site. Anything inside that needs its
 * own interaction (badges, checkbox, links, copy buttons) sits above that
 * stretched link via z-index: 2 in CSS.
 *
 * Selectable nodes (`check` + `href`)
 *   Clicking anywhere on the node toggles its checkbox (the check label stretches
 *   over the node instead of the title link). Only the link icon in the top-right
 *   cluster opens `href`, so a stray tap or remote press never leaves the page.
 *
 * Icon
 *   `icon` puts a small picture before the title, Homepage-style. It takes one string:
 *   `si-github` (a Simple Icons glyph), `jellyfin.svg` (a Dashboard Icons file), `/logo.png`
 *   (an image on the site) or an image URL. See lib/icon.ts. The icon is decorative (alt=""): the
 *   title already names the node. A value it can't place fails the build.
 *
 * Ping
 *   `ping` adds a status dot (and the response time once known) to the top-right cluster. It is
 *   markup only, rendered as "checking": the app decides what to check and paints the result with
 *   `applyPing` from `@zkevinly/ui/lib/ping` (it finds `.node-ping`).
 *
 * Anchors
 *   The title carries `id="node-<slug>"`; the search overlay links to it and
 *   spotlights the node (the consuming site's search overlay does the linking).
 *
 * Slots
 *   default  body content, below the description
 *   foot     pinned to the bottom of the node
 */
import type { HTMLAttributes } from 'astro/types';
import { ChevronRight, ExternalLink } from '@lucide/astro';
import { resolveIcon } from '../../lib/icon';

interface NodeLink {
  label: string;
  href: string;
}

interface Props extends Omit<HTMLAttributes<'article'>, 'title'> {
  title: string;
  description?: string;
  /** Makes the node clickable. */
  href?: string;
  /** Picture before the title: `si-<slug>`, `<name>.svg|png|webp`, a `/path` or an image URL. */
  icon?: string;
  /** Adds a status dot to the top-right cluster, for the app to paint with `applyPing`. */
  ping?: boolean;
  /** Small mono label at the top right (e.g. "Official"). */
  label?: string;
  /** Extra mono pills beside the label (e.g. "Optional"). */
  badges?: string[];
  /** Step number shown before the title (e.g. "01"). */
  number?: string;
  /**
   * Renders a check-off box in the top-right cluster. The value is exposed as
   * `data-check`; the owning composite's script handles state.
   */
  check?: string;
  /** Screen-reader verb for the check box. Defaults to "Mark as done". */
  checkLabel?: string;
  /** Secondary links listed under the body, each with its own icon. */
  links?: NodeLink[];
  /** Heading level for the title (keep the page outline sensible). */
  as?: 'h2' | 'h3' | 'h4';
  size?: 'default' | 'compact';
  /** Dev search only: index this node as its own result (production indexes whole pages). */
  searchable?: boolean;
}

const {
  title,
  description,
  href,
  icon,
  ping = false,
  label,
  badges = [],
  number,
  check,
  checkLabel = 'Mark as done',
  links = [],
  as: Heading = 'h3',
  size = 'default',
  searchable = false,
  class: className,
  ...attrs
} = Astro.props;

// Every title gets a stable anchor (`#node-<slug>`) so search can link straight to
// this node and spotlight it. Pagefind also turns headings with ids into sub-results.
const slug = title
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const anchor = slug ? `node-${slug}` : undefined;

const isExternal = (url: string) => /^https?:\/\//.test(url);
const external = href ? isExternal(href) : false;
// A node with a check box toggles it on click; its link is only the icon.
const selectable = Boolean(check);
const hasAside = ping || badges.length > 0 || Boolean(label) || Boolean(href) || Boolean(check);
const mark = resolveIcon(icon);
---

<article
  class:list={[
    'node',
    size === 'compact' && 'node-compact',
    href && 'node-interactive',
    selectable && 'node-selectable',
    className,
  ]}
  data-search-item={searchable ? '' : undefined}
  {...attrs}
>
  <div class="node-head">
    <Heading class="node-title" id={anchor}>
      {mark?.kind === 'img' && (
        <img
          class="node-icon"
          src={mark.src}
          alt=""
          width="24"
          height="24"
          loading="lazy"
          decoding="async"
          data-pagefind-ignore
        />
      )}
      {mark?.kind === 'svg' && (
        <svg
          class="node-icon"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
          data-pagefind-ignore
        >
          <path d={mark.path} />
        </svg>
      )}
      {number && (
        <span class="node-number" data-pagefind-ignore>
          {number}
        </span>
      )}
      {href && !selectable ? (
        <a
          class="node-link"
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          aria-label={external ? `${title} (opens in a new tab)` : undefined}
        >
          {title}
        </a>
      ) : (
        title
      )}
    </Heading>

    {hasAside && (
      <span class="node-aside" data-pagefind-ignore>
        {ping && (
          <span
            class="node-ping"
            data-state="pending"
            role="img"
            aria-label="Status: checking"
            title="Status: checking"
          >
            <span class="node-ping-dot" aria-hidden="true" />
            <span class="node-ping-text" hidden />
          </span>
        )}
        {badges.map((badge) => (
          <span class="node-badge">{badge}</span>
        ))}
        {label && <span class="node-label">{label}</span>}
        {href && selectable && (
          <a
            class="node-open"
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            aria-label={`Open ${title}${external ? ' (opens in a new tab)' : ''}`}
          >
            {external ? (
              <ExternalLink size={16} aria-hidden="true" />
            ) : (
              <ChevronRight size={16} aria-hidden="true" />
            )}
          </a>
        )}
        {href &&
          !selectable &&
          (external ? (
            <ExternalLink size={16} aria-hidden="true" />
          ) : (
            <ChevronRight size={16} aria-hidden="true" />
          ))}
        {check && (
          <label class="node-check">
            {/* autocomplete=off: stop the browser restoring ticks after a refresh. */}
            <input type="checkbox" data-check={check} autocomplete="off" />
            <span class="sr-only">
              {checkLabel}: {title}
            </span>
          </label>
        )}
      </span>
    )}
  </div>

  {description && <p class="node-desc">{description}</p>}

  <slot />

  {links.length > 0 && (
    <ul class="node-links">
      {links.map((link) => {
        const linkExternal = isExternal(link.href);
        return (
          <li>
            <a
              class="node-action"
              href={link.href}
              target={linkExternal ? '_blank' : undefined}
              rel={linkExternal ? 'noopener noreferrer' : undefined}
            >
              {link.label}
              {linkExternal ? (
                <ExternalLink size={14} aria-hidden="true" />
              ) : (
                <ChevronRight size={14} aria-hidden="true" />
              )}
            </a>
          </li>
        );
      })}
    </ul>
  )}

  <slot name="foot" />
</article>
