---
/**
 * Applies the saved grid/list view (`ui:view` in localStorage) before first paint, so a list
 * doesn't flash as a grid, and keeps it across ClientRouter page swaps. Put it in the layout's
 * head with a ReorderToolbar page; `lib/reorder` does the saving.
 */
---

<script is:inline>
  (() => {
    const apply = (root) => {
      try {
        if (localStorage.getItem('ui:view') === 'list') root.dataset.view = 'list';
        else delete root.dataset.view;
      } catch {
        // Storage blocked: stay on the grid.
      }
    };
    apply(document.documentElement);
    document.addEventListener('astro:before-swap', (event) =>
      apply(event.newDocument.documentElement),
    );
  })();
</script>
