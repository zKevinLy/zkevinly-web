---
/**
 * COMPOSITE: labelled shell commands, each with a copy button (base: Button copy).
 * Takes a list and renders nothing when it is empty. Multi-line scripts keep their line
 * breaks and drop the single-line "> " prompt.
 */
import Button from '../base/Button.astro';
import type { CopyCommand } from '../../types';

interface Props {
  commands?: CopyCommand[];
}

const { commands = [] } = Astro.props;
---

{commands.length > 0 && (
  <div class="cmds">
    {commands.map((command) => {
      const multiline = command.command.includes('\n');
      return (
        <div class="cmd">
          {command.label && <span class="cmd-label">{command.label}</span>}
          <div class="cmd-row" data-copy-root>
            <code class="cmd-text" data-copy-source data-multiline={multiline ? '' : undefined}>
              {command.command}
            </code>
            <Button
              variant="segment"
              copy={command.command}
              label={multiline ? `Copy ${command.label ?? 'script'}` : undefined}
            />
          </div>
        </div>
      );
    })}
  </div>
)}
