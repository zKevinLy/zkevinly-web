{
  "name": "@zkevinly/ui",
  "version": "0.3.0",
  "description": "Presentational Astro components and styles for zkevinly sites. No business logic: data goes in through props.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zKevinLy/zkevinly-web.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "astro-component",
    "astro",
    "ui",
    "components"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./base/*": "./src/components/base/*",
    "./composite/*": "./src/components/composite/*",
    "./layouts/*": "./src/layouts/*",
    "./lib/*": "./src/lib/*.ts",
    "./types": "./src/types.ts",
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@lucide/astro": ">=1.0.0",
    "astro": ">=5.0.0",
    "simple-icons": ">=14.0.0"
  },
  "scripts": {
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "pack:check": "npm pack --dry-run",
    "sync": "node scripts/sync.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
