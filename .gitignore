# Dependencies
node_modules/

# Build output & caches
dist/
.astro/
# Stamped with the release version at deploy time (CI)
public/version.json
*.tsbuildinfo
.eslintcache
.cache/

# Environment & secrets (only the example is committed)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Cloudflare / Wrangler local state (from `wrangler dev` / `npm run deploy`)
.wrangler/

# Test & coverage output (`npm run test:ci`, `npm run test:coverage`)
test-results.xml
coverage/
.nyc_output/

# Lighthouse output (`npm run lighthouse` writes .lighthouseci/)
.lighthouseci/
lhci_reports/
lighthouse-*.json
lighthouse-*.html

# Logs
*.log
npm-debug.log*

# Release archives (CI attaches the built site to each release)
*.zip

# OS / editor
.DS_Store
Thumbs.db
.idea/
